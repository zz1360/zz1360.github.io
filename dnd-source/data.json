  "worlds": [
    {
      "id": "fr",
      "name": "被遗忘的国度",
      "en": "Forgotten Realms",
      "tag": "主线 · 托瑞尔 / 费伦",
      "body": "神祇、城邦、古代魔法帝国与冒险者共同塑造的高魔奇幻世界。剑湾只是费伦西侧的一部分。",
      "details": [
        [
          "尺度",
          "设定：被遗忘的国度 → 星球：托瑞尔 Toril → 大陆：费伦 Faerûn → 区域：剑湾 Sword Coast。不要把这四层当成同义词。"
        ],
        [
          "历史线索",
          "帝国遗产、精灵文明的兴衰、魔网的破坏与恢复，是理解费伦的三条主线。"
        ],
        [
          "认识入口",
          "博德之门、无冬城、深水城和崔斯特故事都属于这个设定，但作品的年代和具体情节未必一致。"
        ]
      ],
      "src": [
        "fr",
        "places",
        "drizzt"
      ],
      "color": "#ceaa72",
      "kind": "物质世界",
      "section": "worlds",
      "aliases": [
        "Toril",
        "Faerun",
        "Faerûn",
        "Sword Coast",
        "托瑞尔",
        "费伦",
        "剑湾"
      ]
    },
    {
      "id": "greyhawk",
      "name": "灰鹰",
      "en": "Greyhawk",
      "tag": "欧斯 Oerth · 古典冒险",
      "body": "以城邦、势力竞争、危险荒野与地下城见长；强大法师并不意味着魔法便利普及到每个平民。",
      "details": [
        [
          "世界特色",
          "灰鹰既是设定名称，也是一座著名城市。理解故事时，需要区分城市与欧斯整个世界。"
        ],
        [
          "人物坐标",
          "魔邓肯、塔莎和维克那的故事根源与灰鹰有关，后来这些人物也进入多元宇宙叙事。"
        ]
      ],
      "src": [
        "greyhawk",
        "three",
        "vecna"
      ],
      "color": "#83afa8",
      "kind": "物质世界",
      "section": "worlds",
      "aliases": []
    },
    {
      "id": "krynn",
      "name": "龙枪",
      "en": "Dragonlance",
      "tag": "克莱恩 Krynn · 战争史诗",
      "body": "神祇的离去与回归、巨龙与龙人军团、骑士和法师传统，是这个世界的核心。",
      "details": [
        [
          "历史线索",
          "大灾变摧毁旧秩序，随后出现长期黑暗时代；龙枪战争中，塔克西丝的龙军团威胁克莱恩。"
        ],
        [
          "事件边界",
          "龙枪战争发生在克莱恩，不是费伦的战争，也不能直接套用 DR 历法。"
        ],
        [
          "故事焦点",
          "与其只记住神器龙枪，更应关注普通人如何在神祇、巨龙和军事机器之间作出选择。"
        ]
      ],
      "src": [
        "dragonlance"
      ],
      "color": "#c27d65",
      "kind": "物质世界",
      "section": "worlds",
      "aliases": []
    },
    {
      "id": "eberron",
      "name": "艾伯伦",
      "en": "Eberron",
      "tag": "魔法工业 · 战后悬疑",
      "body": "魔法进入交通与日常产业，战后政治、谍战和黑色侦探故事与遗迹探险并行。",
      "details": [
        [
          "历史线索",
          "末次战争结束后，国家间仍存在猜疑。哀伤之日将塞尔 Cyre 化为危险的哀伤之地，灾难真因被保留为谜团。"
        ],
        [
          "阅读场景",
          "沙恩 Sharn 的城市街区适合犯罪与调查；哀伤之地适合危险勘探；古老遗迹适合动作冒险。"
        ],
        [
          "不要混用",
          "艾伯伦有独立的历法、神学和位面体系。不能把费伦魔网、神祇干预模式或通用大轮宇宙机械套入。"
        ]
      ],
      "src": [
        "eberron",
        "mourning",
        "eberron-planes"
      ],
      "color": "#9ba7c8",
      "kind": "物质世界",
      "section": "worlds",
      "aliases": []
    },
    {
      "id": "ravenloft",
      "name": "鸦阁 / 魔域",
      "en": "Ravenloft",
      "tag": "恐怖领域 · 哥特恐怖",
      "body": "迷雾、黑暗领主和反复上演的悲剧构成恐怖领域；巴洛维亚只是其中最著名的一个。",
      "details": [
        [
          "世界特色",
          "第五版常把这些恐怖领域置于影界。它们并不是所有都位于一颗普通星球上的邻国。"
        ],
        [
          "人物坐标",
          "吸血鬼斯特拉德统治巴洛维亚；他的权力与永不满足的欲望，也是这个领域的恐怖核心。"
        ],
        [
          "主题",
          "这里的重点常是逃离、记忆、诅咒与代价，而不是征服一片普通大陆。"
        ]
      ],
      "src": [
        "raven"
      ],
      "color": "#aa809d",
      "kind": "位面设定",
      "section": "worlds",
      "aliases": []
    },
    {
      "id": "athas",
      "name": "浩劫残阳",
      "en": "Dark Sun",
      "tag": "阿塔斯 Athas · 荒漠求生",
      "body": "赤色太阳下的残酷荒漠世界；亵渎魔法消耗生态，巫王统治城邦，生存资源决定政治。",
      "details": [
        [
          "与常见奇幻的差异",
          "水和物资的稀缺比一袋金币更能驱动故事。魔法可能直接造成环境代价，强权控制城市与生命。"
        ],
        [
          "版本边界",
          "这里概述经典设定主题，不提供或暗示某个最新版本的专用规则。"
        ]
      ],
      "src": [
        "athas"
      ],
      "color": "#c99969",
      "kind": "物质世界",
      "section": "worlds",
      "aliases": []
    },
    {
      "id": "planescape",
      "name": "异度风景",
      "en": "Planescape",
      "tag": "印记城 Sigil · 位面哲学",
      "body": "把位面、传送门、信念与哲学派系放到前台；印记城是著名的诸门之城。",
      "details": [
        [
          "不是一颗星球",
          "Planescape 是以跨位面生活为中心的设定框架。印记城与外域是重要舞台。"
        ],
        [
          "权力边界",
          "痛苦女士维持印记城秩序，神祇被拒于城外。她的真实本质不应被写成已经证实的神格或战斗等级。"
        ]
      ],
      "src": [
        "planescape",
        "sigil"
      ],
      "color": "#8fa89a",
      "kind": "位面设定",
      "section": "worlds",
      "aliases": []
    },
    {
      "id": "spelljammer",
      "name": "魔法船",
      "en": "Spelljammer",
      "tag": "宇宙航行 · 太空奇幻",
      "body": "魔法船让冒险者离开地面，在狂野空间与星界之海之间航行，访问遥远的世界。",
      "details": [
        [
          "第五版航行",
          "这里采用 2022 年第五版的狂野空间—星界之海框架。星界成为连接不同空间系统的重要通道。"
        ],
        [
          "版本差异",
          "旧版的水晶球与燃素海模型，不能无说明地与新版航行图合并。"
        ],
        [
          "连接不等于统一",
          "跨世界冒险能连接不同设定，却不会让它们共享一条历史或同一组社会规则。"
        ]
      ],
      "src": [
        "spelljammer"
      ],
      "color": "#8fa7c5",
      "kind": "航行框架",
      "section": "worlds",
      "aliases": []
